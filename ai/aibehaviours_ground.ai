
rem *** Construct Tank Weights ***
aiSettings.createBehaviourModifiers  TankWeights
aiSettings.setBehaviourModifier  Avoid  9.0
aiSettings.setBehaviourModifier  MoveTo  2.0
aiSettings.setBehaviourModifier  Idle  0.001
aiSettings.setBehaviourModifier  Fire  2.5
aiSettings.setBehaviourModifier  TakeCover  0.5
aiSettings.setBehaviourModifier  Change  8.0
aiSettings.setBehaviourModifier  Special  7.0
aiSettings.setBehaviourModifier  Revive  6.0
aiSettings.setBehaviourModifier  c4  5.0
aiSettings.setBehaviourModifier  Special2  4.0
aiSettings.setBehaviourModifier  Special3  3.0
aiSettings.setBehaviourModifier  Random  1.5
aiSettings.setBehaviourModifier  Triggerable  1.0

