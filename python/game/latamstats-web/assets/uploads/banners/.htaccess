# Denegar ejecución de scripts en uploads de banners.
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .phps .phar
RemoveType .php .phtml .php3 .php4 .php5 .phps .phar

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php|phtml|php3|php4|php5|phps|phar)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(php|phtml|php3|php4|php5|phps|phar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
