			<maptype players="64" type="aasfullassets" locid="GAMEMODE_DESCRIPTION_aasfullassets"></maptype>
			<maptype players="128" type="aasfullassets" locid="GAMEMODE_DESCRIPTION_aasfullassets"></maptype>
		</mode>
        <mode type="gpm_insurgency">
