			<maptype ai="1" players="64" type="coopfullassets" locid="GAMEMODE_DESCRIPTION_coopfullassets"></maptype>
			<maptype ai="1" players="128" type="coopfulllarge" locid="GAMEMODE_DESCRIPTION_coopfulllarge"></maptype>
